# .env.example — Copy this file to .env and fill in your values.
# Run: cp .env.example .env
# Then edit .env with your real credentials.
# NEVER commit your .env file — it is listed in .gitignore.

# Get api_id and api_hash from https://my.telegram.org/auth → API Development Tools
API_ID=YOUR_API_ID_HERE
API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Channels to export from: comma-separated usernames or numeric IDs.
# Examples: channel1,-1001234567890,channel2
CHANNELS=channel_username

# Name for the Telethon session file (creates <SESSION_NAME>.session)
SESSION_NAME=anon

# Bot filtering (True/False)
SKIP_BOTS=False
ONLY_BOTS=False

# Directory to save exported files (e.g., /sdcard/Download). Leave empty for current directory.
OUTPUT_DIR=
